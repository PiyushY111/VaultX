{
  "name": "@password-manager/server",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted API server storing only encrypted vault data",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "rotate-totp-key": "node dist/rotate-totp-key.js",
    "build:crypto": "tsc -b ../crypto",
    "typecheck": "npm run build:crypto && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pretest": "npm run build:crypto",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@password-manager/crypto": "^0.0.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.1.0",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
