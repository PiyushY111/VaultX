{
  "name": "@password-manager/item-format",
  "version": "0.1.0",
  "private": true,
  "description": "The vault item format (the JSON inside each encrypted item), shared by the web vault and the extension",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
