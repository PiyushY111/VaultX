{
  "name": "@password-manager/extension",
  "version": "0.0.0",
  "private": true,
  "description": "Browser extension client",
  "type": "module",
  "scripts": {
    "build:crypto": "tsc -b ../crypto",
    "prebuild": "npm run build:crypto",
    "build": "node build.mjs",
    "typecheck": "npm run build:crypto && tsc -p tsconfig.json",
    "pretest": "npm run build:crypto",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "clean": "rm -rf dist test-results playwright-report"
  },
  "dependencies": {
    "@password-manager/crypto": "^0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  }
}
