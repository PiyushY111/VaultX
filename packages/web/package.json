{
  "name": "@password-manager/web",
  "version": "0.1.0",
  "private": true,
  "description": "Web vault client",
  "type": "module",
  "scripts": {
    "build:deps": "tsc -b ../crypto ../item-format",
    "predev": "npm run build:deps",
    "dev": "vite",
    "prebuild": "npm run build:deps",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "npm run build:deps && tsc -p tsconfig.json",
    "pretest": "npm run build:deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify-build": "node scripts/verify-build.mjs",
    "clean": "rm -rf dist test-results playwright-report"
  },
  "dependencies": {
    "@password-manager/crypto": "0.1.0",
    "@password-manager/item-format": "0.1.0",
    "@simplewebauthn/browser": "14.0.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldts": "7.4.18",
    "tldts-core": "7.4.18"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
