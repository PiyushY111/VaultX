# Copy to .env and fill in. Never commit .env.

# Postgres credentials (used by both the postgres and api services).
POSTGRES_DB=password_manager
POSTGRES_USER=password_manager
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Keys the fake KDF salts /prelogin returns for unknown emails. Keep it stable
# across restarts. Generate with: openssl rand -base64 32
PRELOGIN_SECRET=

# Required. Encrypts two-factor (TOTP) secrets at rest, so a copy of the
# database alone doesn't reveal them. It doesn't help if the server itself is
# compromised: the key lives here. Don't store it with database backups, and
# don't lose it (two-factor users couldn't log in).
# Generate with: openssl rand -base64 32
# Rotation: put a new key first, comma-separated (new,old), restart, run
# `npm run rotate-totp-key -w @password-manager/server`, then drop the old key.
TOTP_ENCRYPTION_KEY=

# Required. Passkeys (WebAuthn): the domain the web vault is served from (no
# scheme, port or path; not an IP address), and its exact origin(s),
# comma-separated. Browsers only use a passkey on these, which is what makes
# passkeys phishing-resistant. Changing the RP ID later breaks existing
# passkeys. For local development:
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173
# Optional: the name shown in the browser's passkey prompt.
WEBAUTHN_RP_NAME=VaultX

# Optional
API_PORT=3000
LOG_LEVEL=info
SESSION_TTL_SECONDS=86400
# Per-IP limit on /signup, /prelogin and /login (requests per minute).
AUTH_RATE_LIMIT_MAX=10
# Per-account limit: failed logins allowed per window before a temporary lockout.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
# Per-account limits on vault routes (requests per minute, per route), and on
# /vault-items/batch (imports, up to 64 MiB per request).
VAULT_RATE_LIMIT_MAX=120
VAULT_BATCH_RATE_LIMIT_MAX=20
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
