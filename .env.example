# Copy to .env and fill in. Never commit .env.

# Postgres credentials (used by both the postgres and api services).
POSTGRES_DB=password_manager
POSTGRES_USER=password_manager
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Keys the fake KDF salts /prelogin returns for unknown emails. Keep it stable
# across restarts. Generate with: openssl rand -base64 32
PRELOGIN_SECRET=

# Optional
API_PORT=3000
LOG_LEVEL=info
SESSION_TTL_SECONDS=86400
# Per-IP limit on /signup, /prelogin and /login (requests per minute).
AUTH_RATE_LIMIT_MAX=10
# Per-account limit: failed logins allowed per window before a temporary lockout.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
